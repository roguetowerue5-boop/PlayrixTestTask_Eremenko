# Скопируй в .env и впиши ключи. .env в git не попадает.

# Один ключ закрывает текст, vision и генерацию изображений.
OPENROUTER_API_KEY=

# Ключи кастомных провайдеров из providers.yaml (если включишь их)
INTERNAL_ART_API_KEY=

# 1 — весь пайплайн на mock-провайдере, без сети и без ключей.
# Удобно для правки шаблонов офферов: раскладку видно сразу, картинки бесплатны.
OFFERFORGE_OFFLINE=0
